model Roadmap {
  id             String       @id @default(dbgenerated("gen_random_uuid()"))
  isTemplate     Boolean      @default(false) @map("is_template")
  userId         String?      @map("user_id")
  roleCategory   RoleCategory @map("role_category")
  title          String
  description    String?      @db.Text
  goalName       String?      @map("goal_name")
  hoursPerDay    Decimal?     @map("hours_per_day") @db.Decimal(4, 2)
  deadlineDate   DateTime?    @map("deadline_date") @db.Timestamp
  estimatedWeeks Int?         @map("estimated_weeks")
  generatedAt    DateTime     @default(now()) @map("generated_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes RoadmapNode[]

  @@index([userId])
  @@index([isTemplate])
  @@index([roleCategory])
  @@map("roadmaps")
}

model RoadmapNode {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  roadmapId      String   @map("roadmap_id")
  parentId       String?  @map("parent_id")
  skillId        String?  @map("skill_id")
  name           String
  description    String?  @db.Text
  nodeType       NodeType @map("node_type")
  estimatedHours Decimal? @map("estimated_hours") @db.Decimal(6, 2)
  posX           Decimal  @map("pos_x") @db.Decimal(8, 2)
  posY           Decimal  @map("pos_y") @db.Decimal(8, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  roadmap              Roadmap               @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  parent               RoadmapNode?          @relation("RoadmapNodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             RoadmapNode[]         @relation("RoadmapNodeHierarchy")
  skill                Skill?                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userNodeProgress     UserNodeProgress[]
  milestoneSubmissions MilestoneSubmission[]
  milestoneTestSuite   MilestoneTestSuite?

  @@index([roadmapId])
  @@index([parentId])
  @@map("roadmap_nodes")
}

model UserNodeProgress {
  id            String     @id @default(dbgenerated("gen_random_uuid()"))
  userId        String     @map("user_id")
  roadmapNodeId String     @map("roadmap_node_id")
  status        NodeStatus @default(LOCKED)
  startedAt     DateTime?  @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  quizScorePct  Decimal?   @map("quiz_score_pct") @db.Decimal(5, 2)
  quizPassed    Boolean?   @map("quiz_passed")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNode RoadmapNode @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapNodeId])
  @@index([userId])
  @@map("user_node_progress")
}

model DailyActivity {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  userId         String   @map("user_id")
  activityDate   DateTime @map("activity_date")
  nodesCompleted Int      @default(0) @map("nodes_completed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId])
  @@map("daily_activity")
}

model MilestoneTestSuite {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()"))
  roadmapNodeId       String                   @unique @map("roadmap_node_id")
  status              MilestoneTestSuiteStatus @default(NOT_GENERATED)
  title               String?
  summary             String?                  @db.Text
  testCases           Json?                    @map("test_cases")
  testFileContent     String?                  @map("test_file_content") @db.Text
  passThresholdPct    Int                      @default(80) @map("pass_threshold_pct")
  generationStartedAt DateTime?                @map("generation_started_at")
  generatedAt         DateTime?                @map("generated_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  roadmapNode RoadmapNode           @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  submissions MilestoneSubmission[]

  @@map("milestone_test_suites")
}

model MilestoneSubmission {
  id            String                    @id @default(dbgenerated("gen_random_uuid()"))
  userId        String                    @map("user_id")
  roadmapNodeId String                    @map("roadmap_node_id")
  testSuiteId   String?                   @map("test_suite_id")
  repoUrl       String                    @map("repo_url") @db.Text
  testCommand   String                    @default("npm test") @map("test_command")
  status        MilestoneSubmissionStatus
  outputLog     String?                   @map("output_log") @db.Text
  passRatePct   Decimal?                  @map("pass_rate_pct") @db.Decimal(5, 2)
  passedTests   Int?                      @map("passed_tests")
  testResults   Json?                     @map("test_results")
  totalTests    Int?                      @map("total_tests")
  attemptNumber Int                       @default(1) @map("attempt_number")
  createdAt     DateTime                  @default(now()) @map("created_at")
  completedAt   DateTime?                 @map("completed_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNode RoadmapNode         @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  testSuite   MilestoneTestSuite? @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)

  @@index([userId, roadmapNodeId])
  @@index([testSuiteId])
  @@map("milestone_submissions")
}
